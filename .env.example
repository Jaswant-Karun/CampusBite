# CampusBite Environment & Security Configuration
# Copy this file to .env and configure secret keys appropriately.
# NEVER commit the actual .env file or real credentials into version control.

PORT=3000
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/campusbite

# Cryptographic Token Secret (HMAC-SHA256 session signature)
# In production, replace with a 64+ character random hex string
JWT_SECRET=campusbite_production_secret_change_me_before_deploying_2026

# Admin Security Override (Leave empty in standard production)
DEMO_MODE=true
